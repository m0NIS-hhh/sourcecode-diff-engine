{
  "analysis": {
    "profile": "generic"
  },
  "llm": {
    "base_url": "https://api.deepseek.com/v1",
    "model": "deepseek-chat",
    "api_style": "auto",
    "max_tokens": 4096,
    "temperature": 0.1,
    "timeout": 90,
    "max_retries": 3
  },
  "run": {
    "min_similarity": 0.0,
    "max_similarity": 1.0,
    "max_diff_units": 300
  }
}
